# Copy to .env; docker compose reads it automatically.

# Host port the API is published on (bound to 127.0.0.1 only).
CCW_PORT=8080
# Host config file mounted read-only at /etc/ccw/config.yaml.
CCW_CONFIG_FILE=./config.example.yaml
# Bearer token for the public API. Required: compose refuses to start without it.
CCW_AUTH_TOKEN=change-me
# Claude subscription token (wins over the API key).
CLAUDE_CODE_OAUTH_TOKEN=
# Anthropic API key (used when no OAuth token is set).
ANTHROPIC_API_KEY=
# GitHub token for gh / git over https inside sessions.
GH_TOKEN=
# GitLab token for glab inside sessions.
GITLAB_TOKEN=
